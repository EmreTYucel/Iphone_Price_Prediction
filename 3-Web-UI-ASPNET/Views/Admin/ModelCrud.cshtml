@{ViewData["Title"] = "Model Yönetimi"; Layout = "~/Views/Shared/_Layout.cshtml";}
<div class="card-dark p-4 p-lg-5 mb-4 animate-fade-in">
    <h2 class="fw-bold mb-4"><i class="fas fa-database me-2"></i> ML Model Yönetimi</h2>
    <div class="alert alert-info">ML modellerini burada ekleyebilir/silebilirsiniz. (Demo için gerçek API yok)</div>
    <form class="mb-3"><div class="row g-2 align-items-center"><div class="col"><input class="form-control form-control-dark" type="text" placeholder="Model Adı" /></div><div class="col"><button class="btn btn-primary-custom" type="button"><i class="fa-solid fa-plus me-1"></i> Ekle</button></div></div></form>
    <ul class="list-group"><li class="list-group-item bg-dark text-light">- iPhone 14 Pro</li><li class="list-group-item bg-dark text-light">- iPhone 13</li></ul>
</div>
