@{
    ViewData["Title"] = "Tüm Tahminler";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row animate-fade-in">
    <div class="col-12">
        <div class="card-dark p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0"><i class="fas fa-history me-2"></i>Tüm Tahmin Geçmişi</h4>
                <a href="/Admin/Dashboard" class="btn btn-outline-custom btn-sm">
                    <i class="fas fa-arrow-left me-2"></i>Geri Dön
                </a>
            </div>
            
            <div class="table-responsive">
                <table class="table table-dark-custom">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Tarih</th>
                            <th>Kullanıcı</th>
                            <th>Cihaz</th>
                            <th>Fiyat</th>
                        </tr>
                    </thead>
                    <tbody>
                    @{
                        var preds = ViewBag.Predictions as List<dynamic>;
                        if (preds != null && preds.Count > 0)
                        {
                            int i = 1;
                            foreach (var p in preds)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>@(p.Tarih)</td>
                                    <td><span class="fw-semibold"><i class="fa-solid fa-user-secret me-1"></i>@(p.Kullanici)</span></td>
                                    <td>@(p.Cihaz)</td>
                                    <td>@(p.Fiyat) ₺</td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-secondary">Tahmin bulunamadı.</td></tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
