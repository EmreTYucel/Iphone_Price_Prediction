@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var users = ViewBag.Users as List<dynamic>;
}
<div class="row animate-fade-in">
    <div class="col-12">
        <div class="card-dark p-4 mb-4">
            <h2 class="fw-bold mb-3"><i class="fas fa-shield-alt me-2"></i> Admin Dashboard</h2>
            <div class="mb-3"><span class="badge bg-secondary">Rol: Admin</span></div>
            <div class="row g-4">
                <div class="col-md-3">
            <div class="card-dark p-3 text-center d-flex flex-column justify-content-center h-100">
                <span class="text-secondary small mb-2">Toplam Kullanıcı</span>
                <h3 class="fw-bold mb-0">@ViewBag.TotalUsers</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-dark p-3 text-center d-flex flex-column justify-content-center h-100">
                <span class="text-secondary small mb-2">Toplam Tahmin</span>
                <h3 class="fw-bold mb-0">@ViewBag.TotalPredictions</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-dark p-3 text-center d-flex flex-column justify-content-center h-100">
                <span class="text-secondary small mb-2">Toplam Model</span>
                <h3 class="fw-bold mb-0">@ViewBag.TotalModels</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-dark p-3 text-center d-flex flex-column justify-content-center h-100">
                <span class="text-secondary small mb-2">Ortalama Tahmin Fiyatı</span>
                <h3 class="fw-bold mb-0">@ViewBag.AvgPrice ₺</h3>
            </div>
        </div>
        </div>
    </div>
</div>

<div class="row animate-fade-in mb-4">
    <div class="col-12">
        <div class="card-dark p-4 d-flex justify-content-between align-items-center">
             <div>
                <h4 class="fw-bold mb-1"><i class="fas fa-cogs me-2"></i>Sistem Yönetimi</h4>
                <p class="text-secondary mb-0">Model, Segment ve Özellikleri yönetin.</p>
             </div>
             <a asp-action="UpdateModel" class="btn btn-primary-custom">
                <i class="fas fa-arrow-right me-2"></i>Yönetim Paneline Git
             </a>
        </div>
    </div>
</div>

<div class="row animate-fade-in">
    <div class="col-12">
        <div class="card-dark p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0"><i class="fas fa-history me-2"></i>Son Tahminler (Tüm Kullanıcılar)</h4>
                <a href="/Admin/Predictions" class="btn btn-outline-custom btn-sm">
                    Tümünü Gör
                </a>
            </div>
            <table class="table table-dark-custom">
                <thead>
                    <tr><th>#</th><th>Tarih</th><th>Kullanıcı</th><th>Cihaz</th><th>Fiyat</th></tr>
                </thead>
                <tbody>
                @{
                    var preds = ViewBag.AdminPredictions as List<dynamic>;
                    if (preds != null && preds.Count > 0)
                    {
                        int i = 1;
                        foreach (var p in preds)
                        {
                            <tr>
                                <td>@i</td>
                                <td>@(p.Tarih?.Substring(0,10) ?? "-")</td>
                                <td>@(p.Kullanici ?? "-")</td>
                                <td>@(p.Cihaz ?? "-")</td>
                                <td>@(p.Fiyat ?? "-")</td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center text-secondary">Tahmin yok</td></tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="row animate-fade-in">
    <div class="col-12">
        <div class="card-dark p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0"><i class="fas fa-users me-2"></i>Kullanıcı Listesi</h4>
                <button class="btn btn-primary-custom btn-sm" data-bs-toggle="modal" data-bs-target="#createUserModal">
                    <i class="fas fa-user-plus me-2"></i>Kullanıcı Ekle
                </button>
            </div>
            <table class="table table-dark-custom">
                <thead>
                    <tr><th>#</th><th>Kullanıcı Adı</th><th>E-posta</th><th>Rol</th><th>Kayıt Tarihi</th><th>İşlemler</th></tr>
                </thead>
                <tbody id="usersTableBody">
                @if(users != null && users.Count > 0)
                {
                    foreach(var u in users)
                    {
                        <tr>
                            <td>@u.Id</td>
                            <td><span class="fw-semibold"><i class="fa-solid fa-user-secret me-1"></i>@u.Username</span></td>
                            <td>@u.Email</td>
                            <td><span class="badge @(u.Role.Contains("Admin") ? "bg-danger" : "bg-success")">@u.Role</span></td>
                            <td>@u.Tarih</td>
                            <td>
                                <button class="btn btn-sm btn-outline-warning me-1" onclick="toggleRole(@u.Id, '@(u.Role.Contains("Admin") ? "Admin" : "User")')">
                                    @(u.Role.Contains("Admin") ? "User Yap" : "Admin Yap")
                                </button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteUser(@u.Id)">Sil</button>
                            </td>
                        </tr>
                    }
                } else {
                    <tr><td colspan="6" class="text-center text-secondary">Yükleniyor...</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Kullanıcı Ekle Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background: #1a1a1a; border: 1px solid #333;">
            <div class="modal-header border-0">
                <h5 class="modal-title text-light">Yeni Kullanıcı Ekle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createUserForm">
                    <div class="mb-3">
                        <label class="form-label text-light">Kullanıcı Adı</label>
                        <input type="text" class="form-control form-control-dark" name="username" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light">E-posta</label>
                        <input type="email" class="form-control form-control-dark" name="email" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light">Şifre</label>
                        <input type="password" class="form-control form-control-dark" name="password" required minlength="6">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light">Rol</label>
                        <select class="form-select form-select-dark" name="role">
                            <option value="User">User (Standart)</option>
                            <option value="Admin">Admin (Tam Yetki)</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary-custom" onclick="createUser()">Kullanıcı Ekle</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function createUser() {
        const form = document.getElementById('createUserForm');
        const formData = new FormData(form);
        
        // JSON nesnesi oluştur
        const data = {
            username: formData.get('username'),
            email: formData.get('email'),
            password: formData.get('password'),
            role: formData.get('role')
        };
        
        try {
            const response = await fetch('/Admin/CreateUser', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await response.json();
            
            if (result.success) {
                alert('Kullanıcı başarıyla oluşturuldu!');
                bootstrap.Modal.getInstance(document.getElementById('createUserModal')).hide();
                location.reload();
            } else {
                alert('Hata: ' + (result.error || 'Bilinmeyen hata'));
            }
        } catch (error) {
            alert('Hata: ' + error.message);
        }
    }

    async function deleteUser(id) {
        if (!confirm('Bu kullanıcıyı silmek istediğinize emin misiniz?')) return;
        
        try {
            const response = await fetch(`/Admin/DeleteUser/${id}`, { method: 'POST' });
            const result = await response.json();
            
            if (result.success) {
                location.reload();
            } else {
                alert('Silme başarısız: ' + (result.error || 'Bilinmeyen hata'));
            }
        } catch (error) {
            console.error(error);
            alert('Bir hata oluştu');
        }
    }

    async function toggleRole(id, currentRole) {
        const newRole = currentRole === 'Admin' ? 'User' : 'Admin';
        if (!confirm(`Kullanıcı rolünü ${newRole} olarak değiştirmek istiyor musunuz?`)) return;

        try {
            const response = await fetch(`/Admin/SwitchRole?id=${id}&role=${newRole}`, { 
                method: 'POST' 
            });
            const result = await response.json();
            
            if (result.success) {
                location.reload();
            } else {
                alert('Rol değiştirme başarısız: ' + (result.error || 'Bilinmeyen hata'));
            }
        } catch (error) {
            console.error(error);
            alert('Bir hata oluştu');
        }
    }

    // Sayfa yüklendiğinde kullanıcı listesini yenile (Maskeli + Rol)
    document.addEventListener('DOMContentLoaded', async function() {
        try {
            const response = await fetch('http://127.0.0.1:3000/api/users/masked');
            if (response.ok) {
                const users = await response.json();
                const tbody = document.getElementById('usersTableBody');
                if (users.length > 0) {
                    tbody.innerHTML = users.map(u => {
                        const role = u.role_name || 'User';
                        const badgeClass = role === 'Admin' ? 'bg-danger' : 'bg-success';
                        const toggleText = role === 'Admin' ? 'User Yap' : 'Admin Yap';
                        
                        return `
                        <tr>
                            <td>${u.user_id}</td>
                            <td><span class="fw-semibold"><i class="fa-solid fa-user-secret me-1"></i>${u.username_masked || u.username || '-'}</span></td>
                            <td>${u.email_masked || u.user_email || '-'}</td>
                            <td><span class="badge ${badgeClass}">${role}</span></td>
                            <td>${u.created_at ? u.created_at.substring(0, 10) : '-'}</td>
                            <td>
                                <button class="btn btn-sm btn-outline-warning me-1" onclick="toggleRole(${u.user_id}, '${role}')">${toggleText}</button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteUser(${u.user_id})">Sil</button>
                            </td>
                        </tr>
                    `}).join('');
                } else {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center text-secondary">Kullanıcı yok</td></tr>';
                }
            }
        } catch (error) {
            console.error('Kullanıcı listesi yüklenemedi:', error);
        }
    });
</script>
}
