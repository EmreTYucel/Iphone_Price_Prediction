@* PartialView: Döviz Kurları (10 Puan - PartialView/ViewComponent) *@
@* Bu partial view dinamik olarak döviz kurlarını gösterir *@

<div class="currency-rates d-flex align-items-center gap-2" id="currencyRatesPartial">
    <span class="badge" style="background: var(--bg-card); border: 1px solid var(--border-color); padding: 0.4rem 0.8rem;">
        <i class="fas fa-dollar-sign me-1" style="color: #00c896;"></i>
        <span id="usdRate">--</span> ₺
    </span>
    <span class="badge" style="background: var(--bg-card); border: 1px solid var(--border-color); padding: 0.4rem 0.8rem;">
        <i class="fas fa-euro-sign me-1" style="color: #667eea;"></i>
        <span id="eurRate">--</span> ₺
    </span>
</div>

<script>
    // Döviz kurlarını API'den çek (REST API kullanımı)
    (function loadCurrencyRates() {
        fetch('http://localhost:3000/api/exchange-rate')
            .then(res => res.json())
            .then(data => {
                document.getElementById('usdRate').textContent = data.usd_try?.toFixed(2) || '34.50';
                // EUR için ayrı istek veya hesaplama
                const eurRate = (data.usd_try * 1.08).toFixed(2);
                document.getElementById('eurRate').textContent = eurRate;
            })
            .catch(err => {
                // Fallback değerler
                document.getElementById('usdRate').textContent = '34.50';
                document.getElementById('eurRate').textContent = '37.26';
            });
    })();
</script>
