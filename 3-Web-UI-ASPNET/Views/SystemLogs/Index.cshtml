@model IEnumerable<_3_Web_UI_ASPNET.Models.SystemLog>
@{
    ViewData["Title"] = "Sistem Logları";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fas fa-history me-2"></i> Sistem Logları</h2>
        <form asp-action="ClearAllLogs" asp-controller="SystemLogs" method="post" onsubmit="return confirm('Tüm log kayıtları kalıcı olarak silinecek. Emin misiniz?');">
            <button type="submit" class="btn btn-outline-danger btn-sm">
                <i class="fa-solid fa-trash-can me-1"></i> Tüm Logları Temizle
            </button>
        </form>
    </div>

    <div class="card-dark p-4">
        <div class="table-responsive">
            <table class="table table-dark-custom table-hover align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Tarih</th>
                        <th>Kullanıcı</th>
                        <th>İşlem</th>
                        <th>Açıklama</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td>@log.LogId</td>
                            <td>@log.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</td>
                            <td>
                                @if (log.User == null || string.IsNullOrEmpty(log.User.Username))
                                {
                                    <span class="text-muted fst-italic">Misafir / Bilinmiyor</span>
                                }
                                else
                                {
                                    var uName = log.User.Username;
                                    var masked = uName.Length > 2 ? uName.Substring(0, 2) + "***" : uName + "***";
                                    <span class="text-info fw-bold">@masked</span>
                                }
                            </td>
                            <td>
                                @if(log.Action == "Login") {
                                    <span class="badge bg-success">Giriş</span>
                                } else if(log.Action == "Logout") {
                                    <span class="badge bg-secondary">Çıkış</span>
                                } else {
                                    <span class="badge bg-primary">@log.Action</span>
                                }
                            </td>
                            <td>@log.Description</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="fas fa-info-circle me-2"></i> Henüz kayıt bulunamadı.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
